datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AuditLog {
  id               String   @id @default(cuid())
  action           String   // "ASSIGN" | "REVOKE"
  principalId      String
  roleDefinitionId String
  scope            String
  assignmentId     String
  performedBy      String
  createdAt        DateTime @default(now())

  @@map("audit_logs")
}
