# Copy this file to .env and fill in your values — never commit .env

# PostgreSQL (local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/azure_rbac

# Azure Service Principal
# Needs: User Access Administrator (or Owner) on the subscription
# Needs: User.Read.All on Microsoft Graph (for listing AAD users)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# App settings
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
